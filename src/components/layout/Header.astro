---
import Logo from "../branding/Logo.astro";
import Menu from "../ui/Menu.astro";

import { navigation as items } from "../../data/navigation";
import Container from "./Container.astro";
import MobileMenu from "../ui/MobileMenu";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props as Props;
---

<header class={className}>
  <Container class="flex justify-between items-center">
    <Logo variant="dark" />
    <nav>
      <Menu items={items} class="hidden lg:flex" />
      <MobileMenu items={items} class="flex flex-col gap-4 lg:hidden" />
    </nav>
  </Container>
</header>
