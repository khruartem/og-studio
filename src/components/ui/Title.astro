---
import type { ImageMetadata } from "astro";

import { Image } from "astro:assets";

interface Props {
  image: ImageMetadata;
  level: 1 | 2 | 3;
  class?: string;
}

const { image, level, class: className = "" } = Astro.props as Props;

const Heading = `h${level}` as const;
---

<div class={className}>
  <Heading class="sr-only"><slot /></Heading>
  <Image src={image} alt="Заголовок" />
</div>
