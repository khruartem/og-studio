---
import Icon from "./Icon.astro";

import { socials } from "../../data/socials";
---

<ul class="flex">
  {
    socials.map(({ label, href, icon }) => (
      <li class="p-1">
        <a href={href} target="_blank">
          <Icon name={icon} class="text-pulse" aria-label={label} />
        </a>
      </li>
    ))
  }
</ul>
