---
import Icon from "./Icon.astro";

import { socials } from "../../data/socials";
---

<ul class="flex w-fit">
  {
    socials.map(({ label, href, icon }) => (
      <li class="p-1">
        <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label}>
          <Icon name={icon} class="text-pulse" />
        </a>
      </li>
    ))
  }
</ul>
