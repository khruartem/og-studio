---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { class: className = "", ...restProps } = Astro.props as Props;
---

<a {...restProps} class:list={["link", className]}><slot /></a>

<style>
  .link:hover {
    box-shadow: inset 0 -1px 0 var(--color-dark-pulse);
  }

  .link:active {
    color: var(--color-lilac);
  }
</style>
