---
import type { HTMLAttributes } from "astro/types";
import ArrowLeft from "../../assets/icons/arrow_left_segment.svg";
import ArrowRight from "../../assets/icons/arrow_right_segment.svg";
import SlantLeft from "../../assets/icons/slant_left_segment.svg";
import SlantRight from "../../assets/icons/slant_right_segment.svg";

type ButtonShape = "arrow" | "slant" | "flat";

interface Props extends HTMLAttributes<"button"> {
  shape: ButtonShape;
}

const {
  shape,
  disabled = false,
  type = "button",
  class: className = "inline-flex",
  ...restProps
} = Astro.props as Props;

const LeftSegment = shape === "arrow" ? ArrowLeft : SlantLeft;
const RightSegment = shape === "arrow" ? ArrowRight : SlantRight;
---

<button
  data-shape={shape}
  type={type}
  disabled={disabled}
  class:list={["button items-stretch typography-label-2", className]}
  {...restProps}
>
  {
    shape !== "flat" && (
      <LeftSegment class="button__shape button__shape--left" />
    )
  }
  {
    shape !== "flat" ? (
      <span class="button__content">
        <slot />
      </span>
    ) : (
      <slot />
    )
  }
  {
    shape !== "flat" && (
      <RightSegment class="button__shape button__shape--right" />
    )
  }
</button>

<style>
  .button {
    --button-background: var(--color-dark-pulse);
    --button-text: var(--color-light-100);

    color: var(--button-background);
    background: transparent;
  }

  .button:hover {
    --button-background: var(--color-pulse);
  }

  .button:active {
    --button-background: var(--color-lilac);
  }

  .button:disabled {
    opacity: 0.5;
  }

  .button[data-shape="flat"] {
    padding: 4;
    width: 40px;
    height: 40px;
  }

  .button[data-shape="arrow"] .button__content {
    padding-block: 8px;
    padding-inline: 12px 16px;
  }

  .button[data-shape="slant"] .button__content {
    padding-block: 12px;
    padding-inline-end: 16px;
  }

  .button__content {
    color: var(--button-text);
    background-color: var(--button-background);
  }

  .button__shape {
    width: auto;
    height: auto;
    flex-shrink: 0;
  }

  .button__shape--left {
    margin-inline-end: -1px;
  }

  .button__shape--right {
    margin-inline-start: -1px;
  }
</style>
