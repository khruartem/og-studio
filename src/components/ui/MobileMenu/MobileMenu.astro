---
import Menu from "../Menu.astro";
import Socials from "../Socials.astro";
import Copyright from "../Copyright";
import AnimatedBurger from "../AnimatedBurger.astro";
import type { MenuItem } from "../../../data/navigation";

interface Props {
  items: MenuItem[];
  class?: string;
}

const { items, class: className = "" } = Astro.props as Props;
---

<div
  class:list={["mobile-menu", className]}
  data-mobile-menu
  data-state="closed"
>
  <button
    data-trigger
    aria-expanded="false"
    aria-controls="mobile-menu-panel"
    aria-label="Открыть меню"
    type="button"
    class="px-1 py-1.5 w-8 h-8"
  >
    <AnimatedBurger />
  </button>

  <aside
    class="mobile-menu__panel absolute top-10 left-0 w-full bg-black"
    data-panel
  >
    <Menu
      class="flex flex-col w-fit items-center justify-self-center"
      items={items}
    />
    <Socials />
    <Copyright class="w-fit" />
  </aside>
</div>

<style>
  .mobile-menu__panel {
    --panel-height: calc(100dvh - 40px);

    height: var(--panel-height);
    transition: max-height .4s ease;
    max-height: var(--panel-height);
    overflow: hidden;
  }

  [data-mobile-menu][data-state="closed"] .mobile-menu__panel {
    max-height: 0;
  }

  [data-mobile-menu][data-state="opened"] .mobile-menu__panel {
    max-height: var(--panel-height);
  }
</style>

<script>
  import { initMobileMenu } from "./init-mobile-menu";

  initMobileMenu();
</script>
