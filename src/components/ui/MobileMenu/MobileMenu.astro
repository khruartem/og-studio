---
import Menu from "../Menu.astro";
import Socials from "../Socials.astro";
import Copyright from "../Copyright";

import OpenNavigationButton from "../../../assets/icons/burger.svg";

import { navigation } from "../../../data/navigation";

const items = navigation;
---

<div class="mobile-menu" data-mobile-menu data-state="closed">
  <button
    data-trigger
    aria-expanded="false"
    aria-controls="mobile-menu-panel"
    aria-label="Открыть меню"
    type="button"
  >
    <OpenNavigationButton data-open class="text-pulse" />
  </button>

  <aside data-panel>
    <Menu items={items} />

    <Socials />

    <Copyright />
  </aside>
</div>

<style>
  [data-open] {
    visibility: inherit;
  }
</style>

<script>
  import { initMobileMenu } from "./init-mobile-menu";

  initMobileMenu();
</script>
