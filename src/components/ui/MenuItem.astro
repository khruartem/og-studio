---
import type { MenuItem } from "../../data/navigation";

interface Props {
  item: MenuItem;
  class?: string;
}

const { item, class: className = "" } = Astro.props as Props;
const { label, href } = item;
---

<li class:list={["menu-item", className]}>
  <a href={href}>{label}</a>
</li>

<style>
  .menu-item a {
    padding-block: 8px;
  }

  .menu-item:hover a {
    border-bottom: 1px solid var(--color-dark-pulse);
  }

  .menu-item:active a {
    border-bottom: 1px solid var(--color-pulse);
  }
</style>
