---
import SlantedMask from "../../assets/masks/slanted-mask.svg";
import MusicMask from "../../assets/masks/music-mask.svg";
import DesignersMask from "../../assets/masks/designers-mask.svg";

const categoryMasks = {
  theatre: SlantedMask,
  music: MusicMask,
  designers: DesignersMask,
  blogers: SlantedMask,
} as const;

type CategoryVariant = keyof typeof categoryMasks;

export type Category = {
  variant: CategoryVariant;
  image: string;
  title: string | string[];
};

type Props = Category & {
  class?: string;
};

const { variant, image, title, class: className = "" } = Astro.props as Props;

const mask = categoryMasks[variant].src;
---

<article data-variant={variant} class:list={["category-card", className]}>
  <div
    class="category-card__media"
    style=`
    --image: url("${image}");
    --mask: url("${mask}");
  `
  >
  </div>

  <h3 class="category-card__title typography-heading-5-lg text-dark-pulse">
    {
      Array.isArray(title)
        ? title.map((line) => <span class="block">{line}</span>)
        : title
    }
  </h3>
</article>

<style>
  .category-card {
    position: relative;
    height: 366px;
  }

  .category-card[data-variant="theatre"] {
    width: 384px;
  }

  .category-card[data-variant="music"] {
    width: 520px;
  }

  .category-card[data-variant="designers"] {
    width: 656px;
  }

  .category-card[data-variant="blogers"] {
    width: 384px;
  }

  .category-card__media {
    width: 100%;
    height: 100%;

    background-image: var(--image);
    background-repeat: no-repeat;

    mask-image: var(--mask);
    mask-repeat: no-repeat;
  }

  .category-card[data-variant="theatre"] .category-card__media {
    background-size: 233%;
    background-position: 95% 54%;

    mask-size: 100% 100%;
    mask-position: center;
  }

  .category-card[data-variant="music"] .category-card__media {
    background-size: 115%;
    background-position: 52% 343%;

    mask-size: contain;
    mask-position: 100% 0%;
  }

  .category-card[data-variant="designers"] .category-card__media {
    background-size: 138.5%;
    background-position: -25% 78%;

    mask-size: 92%;
    mask-position: 100%;
  }

  .category-card[data-variant="blogers"] .category-card__media {
    background-size: 125%;
    background-position: 28% 8%;

    mask-size: 100% 100%;
    mask-position: center;
  }

  .category-card__title {
    position: absolute;
  }

  .category-card[data-variant="theatre"] .category-card__title {
    left: 0;
    top: 16px;
  }

  .category-card[data-variant="music"] .category-card__title {
    left: 0;
    top: 164px;
    width: min-content;
  }

  .category-card[data-variant="designers"] .category-card__title {
    left: 136px;
    top: 94px;
  }

  .category-card[data-variant="blogers"] .category-card__title {
    left: 32px;
    top: 8px;
  }
</style>
