---
import SlantedMask from "../../assets/masks/slanted-mask.svg";
import MusicMask from "../../assets/masks/music-mask.svg";
import DesignersMask from "../../assets/masks/designers-mask.svg";

const categoryMasks = {
  theatre: SlantedMask,
  music: MusicMask,
  designers: DesignersMask,
  blogers: SlantedMask,
} as const;

type CategoryVariant = keyof typeof categoryMasks;

interface Props {
  variant: CategoryVariant;
  image: string;
  title: string;
  class?: string;
}

const { variant, image, title, class: className = "" } = Astro.props as Props;

const mask = categoryMasks[variant];
---

<article data-variant={variant} class:list={["category-card", className]}>
  <div
    class="category-card__media"
    style=`
    --image: url(${image});
    --mask: url(${mask});
  `
  >
  </div>

  <h3 class="category-card__title typography-heading-5-lg">{title}</h3>
</article>

<style>
  .category-card {
    position: relative;
    height: 366px;
  }

  .category-card[data-variant="theatre"] {
    width: 384px;
  }

  .category-card[data-variant="music"] {
    width: 520px;
  }

  .category-card[data-variant="designers"] {
    width: 656px;
  }

  .category-card[data-variant="blogers"] {
    width: 384px;
  }

  .category-card__media {
    width: 100%;
    height: 100%;

    background-image: var(--image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    mask-image: var(--mask);
    mask-size: 100% 100%;
    mask-position: center;
    mask-repeat: no-repeat;
  }

  .category-card__title {
    position: absolute;
  }

  .category-card[data-variant="theatre"] .category-card__title {
    left: 0;
    top: 16px;
  }

  .category-card[data-variant="music"] .category-card__title {
    left: 0;
    top: 164px;
  }

  .category-card[data-variant="designers"] .category-card__title {
    left: 136px;
    top: 94px;
  }

  .category-card[data-variant="blogers"] .category-card__title {
    left: 32px;
    top: 8px;
  }
</style>
