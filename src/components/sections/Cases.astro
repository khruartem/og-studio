---
import Container from "../layout/Container.astro";
import CaseItem from "../ui/CaseItem.astro";

import { cases } from "../../data/cases";
---

<section>
  <Container class="2xl:pbs-70 pbe-42">
    <ul class="flex flex-wrap 2xl:gap-6">
      {
        cases.map((item) => (
          <li class="2xl:max-w-198">
            <CaseItem {...item} />
          </li>
        ))
      }
    </ul>
  </Container>
</section>
