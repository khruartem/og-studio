---
import Title from "../ui/Title.astro";
import Button from "../ui/Button.astro";
import ArrowDown from "../../assets/icons/arrow_down.svg";

import titleHero from "../../assets/titles/title-hero.png";
---

<section
  class="hero w-full h-dvh max-h-225 flex flex-col items-center justify-between relative 2xl:pbs-144 2xl:pbe-10"
>
  <Title level={1} image={titleHero.src} class="hero__title"
    >Будь творцом. Стань концептом.</Title
  >
  <h2 class="flex flex-col typography-heading-5-md items-center">
    <span>А мы <span class="text-dark-pulse">раскроем</span> потенциал</span
    ><span>и <span class="text-dark-pulse">расскажем</span> всем</span>
  </h2>
  <Button shape="flat"><ArrowDown /></Button>
</section>

<style>
  .hero {
    background-image: url(../../assets/backgrounds/hero-background.png);
    background-size: cover;
    background-repeat: no-repeat;
  }

  :global(.hero__title) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  :global(.hero__title > img) {
    width: 100%;
    height: 100%;
  }
</style>
